<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="service.gammaseries" name="GammaSeries" version="1.3.8" provider-name="dijidev42">
    <requires>
        <import addon="xbmc.python" version="3.0.0" />
        <import addon="script.module.simplejson" version="3.17.0" />
    </requires>
    <extension point="xbmc.service" library="betaseries.py" start="login" />
    <extension point="xbmc.python.pluginsource" library="default.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en">GammaSeries - Synchronization with BetaSeries.com</summary>
        <summary lang="fr">GammaSeries - Synchronisation avec BetaSeries.com</summary>
        <description lang="en">Kodi to BetaSeries synchronization for movies and shows.</description>
        <description lang="fr">Synchronisation de Kodi vers BetaSeries pour les films et les séries.</description>
        <language></language>
        <platform>all</platform>
        <source>https://github.com/dijidev42/kodi-betaseries</source>
        <assets>
            <icon>icon.png</icon>
        </assets>
    </extension>
</addon>